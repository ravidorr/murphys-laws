# Server Configuration
HOST=127.0.0.1
PORT=8787

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Leave empty or set to '*' for development (allows all origins)
# For production, specify exact origins: ALLOWED_ORIGINS=https://murphys-laws.com,https://www.murphys-laws.com
# ALLOWED_ORIGINS=*

# Email Notifications (optional)
# Used for new-submission notices to EMAIL_TO and for the thank-you email sent to a submitter
# when their law is approved (EMAIL_FROM is the sender they see)
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@murphys-laws.com
# EMAIL_TO=admin@murphys-laws.com

# Facebook Integration (optional)
# Required if you use Facebook login and need to handle data deletion callbacks
# Get your App Secret from: https://developers.facebook.com/apps/

# FACEBOOK_APP_SECRET=your_facebook_app_secret_here
# Public site origin. The daily email report reads it (from the environment, else root/backend .env) to build its admin link; defaults to the site URL.
# BASE_URL=https://your-production-domain.com

# Sentry Error Tracking (optional)
# Sign up at https://sentry.io and create a project to get your DSN
# Backend DSN (Node.js project)
# SENTRY_DSN=https://xxxxx@o123456.ingest.sentry.io/123456
# Frontend DSN (same DSN, passed via Vite environment variables)
# VITE_SENTRY_DSN=https://xxxxx@o123456.ingest.sentry.io/123456

# Source map upload (for better stack traces in production)
# Generate an auth token at https://sentry.io/settings/auth-tokens/
# SENTRY_AUTH_TOKEN=your_auth_token
# SENTRY_ORG=your_organization_slug
# SENTRY_PROJECT=your_project_slug

# Admin moderation API (optional)
# Bearer token for /api/v1/admin/* and the /admin page (also /api/v1/admin/ui) (approve/reject submitted laws).
# Must be at least 32 characters; the endpoints and the page return 404 when unset or shorter.
# Generate with: openssl rand -hex 32
# ADMIN_API_TOKEN=your_admin_api_token_here

# Admin "Sign in with GitHub" (optional; works alongside ADMIN_API_TOKEN, which stays the way for the CLI and MCP).
# Register a GitHub OAuth app whose callback URL is <BASE_URL>/api/v1/admin/auth/github/callback
# (production: https://murphys-laws.com/api/v1/admin/auth/github/callback). All four must be set, or sign-in stays off.
# ADMIN_GITHUB_USERS is a comma-separated list of GitHub logins allowed to sign in (case-insensitive).
# ADMIN_SESSION_SECRET signs the 8 hour session cookie and must be at least 32 characters; rotating it signs everyone out.
# Generate with: openssl rand -hex 32
# BASE_URL must be the origin the browser uses (it defaults to https://murphys-laws.com), for example
# http://localhost:5175 when using the Vite dev server.
# GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
# GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
# ADMIN_GITHUB_USERS=your-github-login
# ADMIN_SESSION_SECRET=your_session_secret_here

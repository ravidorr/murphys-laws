# Murphy's Laws - environment variables
#
# Everything here is optional: the app runs with the defaults noted below.
# Copy this file to `.env` at the project root (`cp .env.example .env`). The backend also reads
# `backend/.env`, and the web build (Vite) reads `VITE_*` values from `web/.env` or the shell.
# A line like `# NAME=value` is an example that stays off until you uncomment it.
# Never commit a real `.env` (it is gitignored). In production the deploy workflow writes the
# server's `.env` from GitHub Actions secrets, so change values there, not on the server.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Interface and port the API listens on (defaults: 127.0.0.1 and 8787)
HOST=127.0.0.1
PORT=8787

# Public origin of the site, exactly as a browser reaches it, with no path (default: https://murphys-laws.com).
# Used for the admin link in the daily email report and, for admin GitHub sign-in, the OAuth
# callback URL and the CSRF origin check. Use http://localhost:5175 with the Vite dev server.
# It must be an http(s) URL; an invalid value turns GitHub sign-in off.
# BASE_URL=https://murphys-laws.com

# Comma-separated list of origins allowed by CORS (default: * which allows every origin).
# Production example: https://murphys-laws.com,https://www.murphys-laws.com
# ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------
# Sends new-submission notices to EMAIL_TO and the thank-you email a submitter gets when their
# law is approved (EMAIL_FROM is the sender they see). Email stays off until SMTP_HOST is set.
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                                # default: 587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@murphys-laws.com          # default: noreply@murphys-laws.com
# EMAIL_TO=admin@murphys-laws.com              # default: admin@murphys-laws.com

# ---------------------------------------------------------------------------
# Admin moderation (optional)
# ---------------------------------------------------------------------------
# The admin page (/admin, also /api/v1/admin/ui) and the /api/v1/admin/* endpoints approve, reject
# and edit submitted laws. They return 404 unless at least one way to sign in below is configured.

# API token: for the CLI and MCP, and a fallback on the admin page. Sent as `Authorization: Bearer <token>`.
# Must be at least 32 characters; a shorter token counts as unset. Generate with: openssl rand -hex 32
# ADMIN_API_TOKEN=your_admin_api_token_here

# "Sign in with GitHub" on the admin page. It works alongside ADMIN_API_TOKEN.
# Register a GitHub OAuth app whose callback URL is <BASE_URL>/api/v1/admin/auth/github/callback
# (production: https://murphys-laws.com/api/v1/admin/auth/github/callback). All four settings below
# must be set, or sign-in stays off and the server logs why at startup.
# In GitHub Actions the first two are stored as the secrets ADMIN_GITHUB_OAUTH_CLIENT_ID and
# ADMIN_GITHUB_OAUTH_CLIENT_SECRET, because secret names cannot start with GITHUB_.
# GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
# GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
# Comma-separated GitHub logins allowed to sign in (case-insensitive)
# ADMIN_GITHUB_USERS=your-github-login
# Signs the 8 hour session cookie; at least 32 characters. Rotating it signs everyone out.
# Generate with: openssl rand -hex 32
# ADMIN_SESSION_SECRET=your_session_secret_here

# ---------------------------------------------------------------------------
# Error tracking with Sentry (optional)
# ---------------------------------------------------------------------------
# Sign up at https://sentry.io and create a project to get a DSN.

# Backend DSN (Node.js project)
# SENTRY_DSN=https://xxxxx@o123456.ingest.sentry.io/123456
# Frontend DSN (the same DSN, passed to the web build; put it in web/.env or the shell)
# VITE_SENTRY_DSN=https://xxxxx@o123456.ingest.sentry.io/123456

# Source map upload, for readable stack traces in production (used by the web build)
# Generate an auth token at https://sentry.io/settings/auth-tokens/
# SENTRY_AUTH_TOKEN=your_auth_token
# SENTRY_ORG=your_organization_slug
# SENTRY_PROJECT=your_project_slug

# ---------------------------------------------------------------------------
# Web build (Vite): put these in web/.env or the shell
# ---------------------------------------------------------------------------

# Base URL of the API the web app calls (default: empty, meaning the same origin).
# Set it to run the web app against a backend on a different origin.
# VITE_API_URL=http://localhost:8787
# Public site URL used for canonical links and social images (default: https://murphys-laws.com)
# VITE_SITE_URL=https://murphys-laws.com

# ---------------------------------------------------------------------------
# Operations (optional)
# ---------------------------------------------------------------------------

# Where the backend finds the built web files when it injects page metadata
# (default: web/dist, relative to the project root or backend directory)
# WEB_DIST_PATH=/path/to/web/dist

# Path to the pm2 executable, for the daily report (default: found on PATH)
# PM2_PATH=/usr/local/bin/pm2

# Health check script (backend/scripts/health-check.sh and health-check.ts)
# HEALTH_CHECK_FRONTEND_URL=https://murphys-laws.com               # default: https://murphys-laws.com
# HEALTH_CHECK_API_URL=https://murphys-laws.com/api/health         # default: https://murphys-laws.com/api/health
# Optional override for health-check.ts and health-check.sh when they run by themselves. Without it they
# go to ALERT_EMAIL, then EMAIL_TO. With none of the three set they still run their checks but warn and
# skip the email. It does not change production alerts: health-monitor.sh runs the check with --no-email
# and mails ALERT_EMAIL, then EMAIL_TO. Several addresses can be given as a comma-separated list.
# HEALTH_CHECK_EMAIL_TO=you@example.com

# Where the monitoring scripts and the daily report email (health check, health monitor, SSL monitor,
# cost report, backup restore test, daily report). Default: EMAIL_TO, the admin address from the Email
# section. The shell scripts and the health check also accept a comma-separated list. There is no built-in address: with neither set, the daily report and
# health-check.ts stop with an error, and the shell scripts log a warning (stderr and syslog) and skip
# the email.
# ALERT_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Facebook (not used yet)
# ---------------------------------------------------------------------------
# Nothing reads this today: backend/src/utils/facebook-signed-request.ts takes the secret as a
# parameter and no route calls it yet. Remove it if the data-deletion callback is dropped.
# Get your App Secret from: https://developers.facebook.com/apps/
# FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# ---------------------------------------------------------------------------
# Other packages
# ---------------------------------------------------------------------------
# The MCP server (mcp/) reads MURPHYS_API_URL (default: https://murphys-laws.com); see mcp/README.md.

#!/bin/sh

# Block push if high/critical production vulnerabilities exist.
echo "Running production dependency audit (high/critical)..."
if ! npm audit --omit=dev --audit-level=high; then
  echo ""
  echo "Production dependency audit failed. Fix the reported vulnerabilities before pushing."
  exit 1
fi

echo "Running full dependency audit (informational)..."
npm audit || echo "Full audit reports known development-tooling advisories."

# Deployment reminder
echo ""
echo "Code pushed to GitHub!"
echo ""
echo "If you pushed to 'main', deployment to production will start automatically."
echo "Check progress at: https://github.com/ravidorr/murphys-laws/actions"
echo ""

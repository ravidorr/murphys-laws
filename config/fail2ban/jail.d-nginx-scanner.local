# Install on the droplet as /etc/fail2ban/jail.d/nginx-scanner.local, then
# `sudo fail2ban-client reload`.
#
# BEFORE enabling, add your own address and any uptime monitor or health-check
# addresses to ignoreip (space separated), otherwise a false positive blocks them
# from the website (ports 80 and 443) for 24 hours. SSH is not affected: the ban
# only covers the ports listed in `port` below.
[nginx-scanner]
enabled  = true
port     = http,https
filter   = nginx-scanner
logpath  = /var/log/nginx/scanner.log
maxretry = 5
findtime = 600
bantime  = 86400
ignoreip = 127.0.0.1/8 ::1

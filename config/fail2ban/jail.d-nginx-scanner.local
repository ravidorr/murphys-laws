# Install on the droplet as /etc/fail2ban/jail.d/nginx-scanner.local, then
# `sudo fail2ban-client reload`. Installing this file enables the jail (enabled = true
# below), so edit ignoreip BEFORE the reload.
#
# Add your own address and any uptime monitor or health-check addresses to ignoreip
# (space separated), otherwise a false positive blocks them from the website (ports 80
# and 443) for 24 hours. SSH is not affected by this jail: its ban only covers the ports
# listed in `port` below, and a separate sshd jail is independent.
#
# To lift a ban early: sudo fail2ban-client set nginx-scanner unbanip <ip>
[nginx-scanner]
enabled  = true
# Debian and Ubuntu ship jail.d/defaults-debian.conf with backend = systemd as the default for
# every jail. A systemd jail reads the journal and ignores logpath, so without this line this jail
# would never see a strike. It reads a log file, so set the backend explicitly. After a reload,
# `sudo fail2ban-client status nginx-scanner` should list /var/log/nginx/scanner.log and
# /var/log/nginx/access.log as its "File list"; "Journal matches" instead means the jail is still
# on the systemd backend.
backend  = auto
port     = http,https
filter   = nginx-scanner
# scanner.log holds the 444 strikes; access.log holds the malformed requests nginx answers with a 400
# (see the filter). fail2ban reads every file listed in logpath, one per line.
logpath  = /var/log/nginx/scanner.log
           /var/log/nginx/access.log
maxretry = 5
findtime = 600
bantime  = 86400
ignoreip = 127.0.0.1/8 ::1
